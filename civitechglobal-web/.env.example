# Base URL of the CiviTechGlobal REST API (no trailing slash). In production this is
# typically proxied through nginx at /api, so VITE_API_URL can stay as /api.
VITE_API_URL=/api

# Deep link to the CiviTechGlobal Telegram insurance bot, used by CTAs across the site.
VITE_TELEGRAM_BOT_URL=https://t.me/civitechglobal_bot
