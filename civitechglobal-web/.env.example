# Base URL of the CiviTechGlobal REST API (no trailing slash). In production this is
# typically proxied through nginx at /api, so VITE_API_URL can stay as /api.
VITE_API_URL=/api

# CURRENTLY UNUSED. Deep link to the Telegram insurance bot. Nothing on the
# public site reads this any more: the bot is no longer advertised to visitors,
# so the hero, services and contact pages point at the on-site request flow
# instead. The bot itself still runs and still accepts requests; only the links
# to it were removed. Kept here, with its type in src/vite-env.d.ts, so putting
# them back is a matter of restoring the links rather than rebuilding the wiring.
VITE_TELEGRAM_BOT_URL=https://t.me/civitechglobal_bot

# The address search engines should treat as this site's real one. Used for
# <link rel="canonical"> and og:url, which are set per route at runtime.
# Leave empty in development and the current origin is used instead.
VITE_CANONICAL_ORIGIN=https://rayantamaddonjahangostar.ir

# Optional: visitor analytics. Set BOTH Umami variables to load a self-hosted
# Umami tracker (keeps the CSP script-src 'self' intact), or set VITE_GA4_ID
# for Google Analytics 4 (GA4 also requires adding www.googletagmanager.com to
# the CSP script-src in nginx.conf). With neither set, no tracker loads at all.
#VITE_UMAMI_SRC=https://analytics.example.com/script.js
#VITE_UMAMI_WEBSITE_ID=
#VITE_GA4_ID=

# Optional: verified social profiles, claimed in the Organization structured
# data on the home page (feeds the knowledge panel). Only set ones that exist.
#VITE_SOCIAL_INSTAGRAM=https://instagram.com/your-handle
#VITE_SOCIAL_LINKEDIN=https://linkedin.com/company/your-page
#VITE_SOCIAL_GITHUB=https://github.com/your-org
#VITE_SOCIAL_X=https://x.com/your-handle
