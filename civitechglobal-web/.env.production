# Product features for the production build (src/lib/features.ts).
# Each defaults to off in a production build when unset. Keep in step with
# the API's switches in civitech-deploy/group_vars/all/main.yml.
#
# Turned on 2026-10-09 at the owner's request: production carries
# everything development does. Market ordering stays off, as it is in
# development. Not secrets: everything here ends up in the bundle.
VITE_FEATURE_TRADEMASTER=true
VITE_FEATURE_TRADEMASTER_ORDERS=false
VITE_FEATURE_JOBS_V2=true
VITE_FEATURE_PROJECTS_V2=true
VITE_FEATURE_BOOKS_V2=true
