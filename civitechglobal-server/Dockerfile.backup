# Scheduled Postgres backup sidecar. Uses the postgres:16-alpine image
# directly so `pg_dump` always matches the server's major version (see
# scripts/backup-postgres.sh header comment).
FROM postgres:16-alpine

# rclone pushes each dump off the host. A backup stored on the same disk as
# the database it protects does not survive the event it exists for.
RUN apk add --no-cache bash rclone

WORKDIR /app
COPY scripts ./scripts
RUN chmod +x scripts/backup-postgres.sh scripts/backup-loop.sh

ENTRYPOINT ["bash", "scripts/backup-loop.sh"]
