generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum LeadStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// How a product is sold. SELF_SERVE products publish a real field list and get
/// a full form; CALLBACK products are priced by hand, so their form collects a
/// structured brief and a call is scheduled instead.
enum IntakeMode {
  SELF_SERVE
  CALLBACK
}

enum ProductAudience {
  INDIVIDUAL
  CORPORATE
}

/// Which channel a request arrived through. Both are first-class: the website
/// carries the full per-product form, the bot carries a short one.
enum RequestSource {
  WEB
  TELEGRAM
}

/// Named bundle of permission strings that can be assigned to a User in
/// addition to (or instead of) ad-hoc permissions on the user itself.
model AdminRole {
  id          String    @id @default(cuid())
  name        String    @unique
  permissions String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  users User[]

  @@index([deletedAt])
  @@map("admin_roles")
}

model User {
  id        String @id @default(cuid())
  // NOTE: email is stored in plaintext for this pass. `emailHash` is a
  // deterministic (non-reversible) lookup key so uniqueness/queries never
  // need to scan-and-compare plaintext. If field-level encryption at rest is
  // added later, `email` becomes ciphertext and every read path already goes
  // through emailHash, so no query code needs to change.
  email     String
  emailHash String @unique @map("email_hash")

  username String? @unique

  password  String
  firstName String
  lastName  String

  role        Role     @default(USER)
  permissions String[] @default([])

  phone String?

  adminRoleId String?
  adminRole   AdminRole? @relation(fields: [adminRoleId], references: [id], onDelete: SetNull)

  // Bumped to invalidate every outstanding access/refresh token for this user
  // (e.g. "log out everywhere", password reset, account compromise).
  tokenVersion Int @default(0)

  emailVerified Boolean @default(false)

  /// Two-factor authentication, TOTP.
  ///
  /// Opt-in per account. Staff can read NDA-bound client attachments and every
  /// CV that arrives, so a stolen password should not be the whole story.
  ///
  /// The secret is stored as base32 — the same form the authenticator holds.
  /// Encrypting it at rest would only help against a database dump taken
  /// without the application key, which is worth doing once there is a key
  /// management story; today the honest protection is that the column is never
  /// selected outside the enrolment and verification paths.
  mfaSecret        String?   @map("mfa_secret")
  /// Null means enrolment was started and never confirmed, so MFA is not on.
  mfaEnabledAt     DateTime? @map("mfa_enabled_at")
  /// SHA-256 of each code. They are credentials; a dump must not yield working
  /// ones, and each is deleted from the array as it is spent.
  mfaRecoveryCodes String[]  @default([]) @map("mfa_recovery_codes")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  refreshTokens RefreshToken[]
  tokens        UserToken[]

  /// Contact tickets this account has answered.
  contactReplies ContactReply[] @relation("ContactReplyAuthor")

  // ---- Marketplace --------------------------------------------------------
  verification          UserVerification?
  verificationsReviewed UserVerification[] @relation("VerificationReviewer")

  jobPosts             JobPost[]        @relation("JobAuthor")
  jobsReviewed         JobPost[]        @relation("JobReviewer")
  jobApplications      JobApplication[] @relation("JobApplicant")
  applicationsReviewed JobApplication[] @relation("ApplicationReviewer")

  freelanceProjects FreelanceProject[] @relation("ProjectAuthor")
  projectsReviewed  FreelanceProject[] @relation("ProjectReviewer")

  books         BookListing[] @relation("BookSeller")
  booksReviewed BookListing[] @relation("BookReviewer")

  /// TradeMaster. A shop belongs to the person who opened it; the reviewer
  /// side is staff, and is the same shape as every other moderation queue.
  businesses         Business[] @relation("BusinessOwner")
  businessesReviewed Business[] @relation("BusinessReviewer")
  productsReviewed   Product[]  @relation("ProductReviewer")

  bids                  ProjectBid[]          @relation("Bidder")
  bidsReviewed          ProjectBid[]          @relation("BidReviewer")
  awardsMade            MarketplaceAward[]    @relation("AwardedBy")
  assignedRequests      InsuranceRequest[]    @relation("LeadAssignee")
  consultationsAssigned ConsultationRequest[] @relation("ConsultationAssignee")

  assignedProjectRequests ProjectRequest[]   @relation("AssignedProjectRequests")
  authoredProposals       ProjectProposal[]  @relation("AuthoredProposals")
  assignedResumes         ResumeSubmission[] @relation("AssignedResumes")

  // ---- Marketplace expansion ---------------------------------------------
  //
  // Public profile fields. Contact details (email/phone) are NEVER part of
  // the public profile — see profile.service for what is exposed.

  /// One-liner shown on the public profile and next to the author's name.
  headline String?
  /// Free text, ~1000 chars max (validated in the service layer).
  bio      String?
  website  String?

  /// Staff-controlled circuit breaker: a paused user cannot post, apply, bid
  /// or message, but their existing listings stay readable. Pausing hides the
  /// profile entirely — see profile.service.
  marketplacePaused Boolean   @default(false) @map("marketplace_paused")
  pausedAt          DateTime? @map("paused_at")
  pausedReason      String?   @map("paused_reason")

  reviewsReceived MarketplaceReview[]  @relation("Reviewee")
  reviewsGiven    MarketplaceReview[]  @relation("Rater")
  notifications   Notification[]
  messagesSent    MarketplaceMessage[] @relation("MessageSender")

  @@index([role])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("users")
}

/// One row per issued refresh token. We never store the raw JWT — only a
/// SHA-256 hash of its `jti` claim — so a leaked database dump can't be
/// replayed as a valid refresh token.
model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// What a one-time link is for. One table rather than two: the lifecycle is
/// identical — issue, hash, expire, spend once — and only the wording of the
/// email and the action taken on redemption differ.
enum UserTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

/// A single-use link sent to an email address.
///
/// Only a SHA-256 hash of the token is stored, for the same reason refresh
/// tokens are: the raw value exists in the recipient's inbox and nowhere else,
/// so a database dump cannot be replayed as a working reset link.
model UserToken {
  id      String           @id @default(cuid())
  userId  String           @map("user_id")
  purpose UserTokenPurpose
  /// SHA-256 of the token that was emailed. Unique so a collision is a
  /// database error rather than two accounts sharing one link.
  token   String           @unique

  expiresAt DateTime  @map("expires_at")
  /// Set the moment it is redeemed. A spent link is kept rather than deleted so
  /// a second click can be told "already used" instead of "invalid", and so the
  /// history is there if an account is ever disputed.
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("createdAt")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("user_tokens")
}

model InsuranceCategory {
  id      String  @id @default(cuid())
  /// Stable identity and URL segment. `title` is display text and may change.
  slug    String  @unique
  title   String  @unique
  titleEn String  @map("title_en")
  emoji   String?
  icon    String?

  displayOrder Int @default(0) @map("display_order")

  /// Pre-refactor categories are kept for the legacy requests that reference
  /// them, but set inactive so they never appear in the public catalog.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products      InsuranceProduct[]
  subcategories InsuranceSubcategory[]
  requests      InsuranceRequest[]

  @@map("insurance_categories")
}

/// One row per catalog product, seeded from `src/insurance/catalog`.
///
/// The database is a read model here, not the source of truth: `prisma/seed.ts`
/// writes these rows from the typed catalog on every deploy. Editing a row by
/// hand will be overwritten on the next seed — change the catalog instead.
/// `formSchema` is the resolved field list (product questions plus the shared
/// contact block) that the web app renders and the API validates against.
model InsuranceProduct {
  id         String @id @default(cuid())
  slug       String @unique
  categoryId String @map("category_id")

  title         String
  titleEn       String @map("title_en")
  summary       String
  summaryEn     String @map("summary_en")
  description   String
  descriptionEn String @map("description_en")

  coverages         String[] @default([])
  optionalCoverages String[] @default([]) @map("optional_coverages")
  notes             String[] @default([])
  exclusions        String[] @default([])
  requiredDocuments String[] @default([]) @map("required_documents")
  premiumFactors    String[] @default([]) @map("premium_factors")

  /// [{ question, answer }] — shape enforced by the catalog, not the database.
  faq Json?

  /// [{ label, value }] — the spec strip at the top of the product page.
  keyFacts Json? @map("key_facts")

  claimSteps String[] @default([]) @map("claim_steps")

  intakeMode IntakeMode      @default(SELF_SERVE) @map("intake_mode")
  audience   ProductAudience @default(INDIVIDUAL)

  icon         String?
  displayOrder Int     @default(0) @map("display_order")
  active       Boolean @default(true)

  formSchema     Json @map("form_schema")
  catalogVersion Int  @default(1) @map("catalog_version")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category InsuranceCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  requests InsuranceRequest[]

  @@index([categoryId])
  @@index([active])
  @@map("insurance_products")
}

/// DEPRECATED — retained only so pre-refactor rows in `insurance_requests`
/// keep a readable category label. Nothing writes to this table any more; new
/// requests point at `InsuranceProduct` instead. Drop it once the legacy rows
/// have been closed out.
model InsuranceSubcategory {
  id         String @id @default(cuid())
  categoryId String @map("category_id")
  title      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category InsuranceCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  requests InsuranceRequest[]

  @@unique([categoryId, title])
  @@index([categoryId])
  @@map("insurance_subcategories")
}

/// An insurance enquiry, however it arrived.
///
/// Was `Lead`, and shaped entirely around the Telegram bot: every row required
/// a `telegramUserId`, a category and a subcategory. Since the website now
/// carries a distinct form per product, the fixed columns cannot describe a
/// submission on their own — `productId` says which form was filled and
/// `answers` holds what was answered, validated against that product's schema
/// at `catalogVersion`.
///
/// The Telegram columns stay nullable rather than being dropped: rows collected
/// before the refactor are real enquiries that people are still owed a call
/// about, and the bot continues to write here with `source = TELEGRAM`.
model InsuranceRequest {
  id String @id @default(cuid())

  /// Short human-quotable reference, given to the applicant on submission so
  /// they can check progress without an account. Not a secret — status lookup
  /// by this code returns state only, never personal data.
  trackingCode String @unique @map("tracking_code")

  source RequestSource @default(WEB)

  telegramUserId    String? @map("telegram_user_id")
  telegramUsername  String? @map("telegram_username")
  telegramFirstName String? @map("telegram_first_name")

  productId String? @map("product_id")

  /// Legacy taxonomy. Populated on pre-refactor rows and by the bot's short
  /// flow; null on a website submission, which resolves its category through
  /// the product.
  categoryId    String? @map("category_id")
  subcategoryId String? @map("subcategory_id")

  /// The answers to `product.formSchema`, keyed by field name.
  answers        Json?
  /// Which catalog version the form was filled under, so the admin panel can
  /// flag answers whose questions have since changed.
  catalogVersion Int?  @map("catalog_version")

  fullName        String  @map("full_name")
  phoneNumber     String  @map("phone_number")
  // Deterministic hash of the normalized phone number, for fast lookup/dedupe
  // without needing to decrypt every row (see note on User.emailHash).
  phoneNumberHash String? @map("phone_number_hash")
  /// True when the number was proved reachable by one-time code before the
  /// request was accepted. Always false for bot-sourced rows.
  phoneVerified   Boolean @default(false) @map("phone_verified")

  email            String?
  organizationName String? @map("organization_name")

  province             String?
  city                 String
  preferredContactTime String  @map("preferred_contact_time")
  notes                String?

  /// When a specialist has agreed to call back.
  callbackScheduledAt DateTime? @map("callback_scheduled_at")

  status LeadStatus @default(NEW)

  // Row-level ownership: null means the lead sits in the unassigned pool.
  // ADMIN principals only see/act on leads assigned to them or unassigned;
  // SUPER_ADMIN sees/acts on all leads regardless of this field.
  assignedToId String? @map("assigned_to_id")
  assignedTo   User?   @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product     InsuranceProduct?     @relation(fields: [productId], references: [id], onDelete: Restrict)
  category    InsuranceCategory?    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory InsuranceSubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([createdAt])
  @@index([phoneNumberHash])
  @@index([assignedToId])
  @@index([productId])
  @@index([source])
  @@map("insurance_requests")
}

// ===========================================================================
// Software project enquiries
//
// The shape of this follows ordinary agency practice rather than anything
// invented here: a client submits a brief, we triage it, ask for whatever the
// brief left ambiguous, and answer with a proposal. The proposal is where the
// money question gets answered honestly — see the note on ProjectProposal.
// ===========================================================================

enum ProjectRequestStatus {
  /// Received, nobody has looked at it yet.
  SUBMITTED
  /// Being read and costed.
  IN_REVIEW
  /// We have asked the client something and are waiting on them.
  NEEDS_CLARIFICATION
  /// A proposal has been sent; the ball is with the client.
  PROPOSAL_SENT
  /// Client accepted a proposal. The engagement starts here.
  ACCEPTED
  /// We declined it, or the client went elsewhere.
  DECLINED
  /// The client pulled the request.
  WITHDRAWN
  /// No answer before the proposal's validity date passed.
  EXPIRED
}

enum ProjectType {
  NEW_BUILD
  REBUILD
  INTEGRATION
  MOBILE_APP
  WEB_APP
  DATA_PLATFORM
  AUTOMATION
  MAINTENANCE
  CONSULTING
  OTHER
}

/// How the client would like to be billed. `NOT_SURE` is a real and common
/// answer, and pretending otherwise just produces a guess in the data.
enum EngagementModel {
  FIXED_PRICE
  TIME_AND_MATERIALS
  RETAINER
  NOT_SURE
}

enum ProjectUrgency {
  EXPLORING
  NEXT_QUARTER
  NEXT_MONTH
  URGENT
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  /// Past `validUntil` with no answer. Set by whoever reads it next, not by a
  /// background job — the date on the row is the source of truth either way.
  EXPIRED
  /// Superseded by a later version, or pulled by us.
  WITHDRAWN
}

/// A client, identified by the pair (email, phone).
///
/// There is no account and no verification code on this flow, so this record
/// is what stands in for an identity. Both hashes are unique, which is what
/// enforces the pairing rule: an email that has been seen with one phone
/// number cannot later be used with a different one, and vice versa. The
/// effect is that abuse costs a fresh email AND a fresh phone number rather
/// than a fresh browser session.
///
/// It also carries the rate-limit state. Counting rows on ProjectRequest would
/// work too, but this keeps the check to a single indexed read.
model ClientIdentity {
  id String @id @default(cuid())

  email     String
  emailHash String @unique @map("email_hash")

  /// Normalised to 09xxxxxxxxx before hashing, so formatting differences
  /// cannot be used to slip past the pairing rule.
  phone     String
  phoneHash String @unique @map("phone_hash")

  /// Denormalised rate-limit state. `requestCount` is lifetime, not windowed;
  /// the windowed check reads ProjectRequest.createdAt.
  requestCount  Int       @default(0) @map("request_count")
  lastRequestAt DateTime? @map("last_request_at")

  /// Standing, set by staff through PATCH /api/admin/identities/:id.
  ///
  /// Mutually exclusive in practice — the endpoint takes one of
  /// normal | trusted | blocked and writes both columns — because "trusted and
  /// blocked" has no meaning and leaving it representable means somebody has to
  /// decide which wins at the point it matters least.
  ///
  /// trusted lets a known client past the daily cap; blocked refuses every
  /// submission without deleting their history.
  trusted Boolean @default(false)
  blocked Boolean @default(false)

  requests ProjectRequest[]
  resumes  ResumeSubmission[]

  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")

  @@map("client_identities")
}

model ProjectRequest {
  id String @id @default(cuid())

  /// Quotable reference. Also how the client reads their proposal back without
  /// an account, so it is generated from the same ambiguity-free alphabet as
  /// the insurance tracking code.
  trackingCode String @unique @map("tracking_code")

  identityId String         @map("identity_id")
  identity   ClientIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)

  // ---- Who is asking -----------------------------------------------------
  contactName      String  @map("contact_name")
  contactRole      String? @map("contact_role")
  organizationName String? @map("organization_name")
  website          String?
  /// Copied from the identity at submission time. Denormalised on purpose: a
  /// request should still read correctly if the identity row is ever merged.
  email            String
  phone            String

  // ---- What they want ----------------------------------------------------
  title           String
  /// The problem in their words. This is the field that actually matters.
  summary         String
  projectType     ProjectType @default(OTHER) @map("project_type")
  /// web, ios, android, desktop, api …
  platforms       String[]    @default([])
  /// What success looks like to them.
  goals           String?
  targetUsers     String?     @map("target_users")
  /// Systems this has to talk to, and anything already built.
  existingSystems String?     @map("existing_systems")
  constraints     String?
  /// Anything they consider out of scope up front.
  outOfScope      String?     @map("out_of_scope")

  // ---- When --------------------------------------------------------------
  urgency        ProjectUrgency @default(EXPLORING)
  desiredStartAt DateTime?      @map("desired_start_at")
  deadlineAt     DateTime?      @map("deadline_at")
  deadlineReason String?        @map("deadline_reason")

  // ---- Money -------------------------------------------------------------
  //
  // Asked as a range, not a number. An early-stage software estimate carries
  // roughly -25%/+75% accuracy, so a single figure from either side is a
  // fiction; a range is the honest question and the honest answer.
  //
  // Amounts are stored in whole IRR toman as BigInt. Not Float: money in a
  // binary float is a rounding bug waiting for a large number, and Iranian
  // amounts get large.
  budgetMin       BigInt?         @map("budget_min")
  budgetMax       BigInt?         @map("budget_max")
  /// What the client thinks the job is worth, if they offered a figure.
  suggestedPrice  BigInt?         @map("suggested_price")
  currency        String          @default("IRT")
  /// True when the client says they have no idea what this should cost, which
  /// is a legitimate answer and changes how the first reply is written.
  budgetUnknown   Boolean         @default(false) @map("budget_unknown")
  engagementModel EngagementModel @default(NOT_SURE) @map("engagement_model")

  // ---- Handling ----------------------------------------------------------
  status        ProjectRequestStatus @default(SUBMITTED)
  ndaRequired   Boolean              @default(false) @map("nda_required")
  /// Free text from the client, and separately our own notes on the row.
  clientNotes   String?              @map("client_notes")
  internalNotes String?              @map("internal_notes")

  assignedToId String? @map("assigned_to_id")
  assignedTo   User?   @relation("AssignedProjectRequests", fields: [assignedToId], references: [id], onDelete: SetNull)

  attachments ProjectAttachment[]
  proposals   ProjectProposal[]

  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")

  @@index([status])
  @@index([createdAt])
  @@index([identityId])
  @@index([assignedToId])
  @@map("project_requests")
}

/// An uploaded file.
///
/// The bytes never live in the database and never live under the web root.
/// `storedName` is a generated name; `originalName` is only ever echoed back
/// as text, never used to build a path.
model ProjectAttachment {
  id String @id @default(cuid())

  requestId String         @map("request_id")
  request   ProjectRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  /// As the client named it. Display only.
  originalName String @map("original_name")
  /// Random name on disk, with an extension we chose from the sniffed type.
  storedName   String @unique @map("stored_name")
  /// The type we detected from the file's own bytes, not from the request.
  mimeType     String @map("mime_type")
  sizeBytes    Int    @map("size_bytes")
  /// SHA-256 of the content, for de-duplication and for proving a file has not
  /// been swapped on disk.
  checksum     String

  createdAt DateTime @default(now()) @map("createdAt")

  @@index([requestId])
  @@map("project_attachments")
}

/// Our answer.
///
/// The point of this record is to be more honest than a single number. It
/// restates the scope as we understood it, says what is NOT included, and
/// prices a RANGE rather than a point:
///
///   - Vague scope with no stated exclusions is the single biggest cause of
///     fixed-price disputes, so `exclusions` is as prominent as `deliverables`.
///   - A three-point estimate (optimistic / likely / pessimistic) is the
///     standard way to express an early estimate. `pertHours` stores the
///     PERT weighting (O + 4M + P) / 6 so the headline figure and the range
///     it came from cannot drift apart.
///   - `validUntil` exists because a price with no expiry is a promise with
///     no end. Thirty days is the usual default.
model ProjectProposal {
  id String @id @default(cuid())

  requestId String         @map("request_id")
  request   ProjectRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  /// 1, 2, 3 … A revised offer is a new version, not an edit, so what the
  /// client was shown at the time stays on the record.
  version Int @default(1)

  status ProposalStatus @default(DRAFT)

  /// Scope as WE understood it, in our words. If this is wrong, everything
  /// after it is wrong, which is why it is the first thing the client reads.
  scopeSummary String @map("scope_summary")

  deliverables String[] @default([])
  assumptions  String[] @default([])
  /// Stated explicitly, always. See the note above.
  exclusions   String[] @default([])
  /// [{ title, description, durationDays, price }]
  milestones   Json?

  engagementModel EngagementModel @default(FIXED_PRICE) @map("engagement_model")

  // ---- Effort ------------------------------------------------------------
  optimisticHours  Int? @map("optimistic_hours")
  likelyHours      Int? @map("likely_hours")
  pessimisticHours Int? @map("pessimistic_hours")
  /// (O + 4M + P) / 6, rounded. Computed on write, stored so that reports and
  /// the client's view agree without recomputing.
  pertHours        Int? @map("pert_hours")

  // ---- Price -------------------------------------------------------------
  priceMin    BigInt? @map("price_min")
  priceLikely BigInt? @map("price_likely")
  priceMax    BigInt? @map("price_max")
  currency    String  @default("IRT")
  /// Rate used when the model is time-and-materials.
  hourlyRate  BigInt? @map("hourly_rate")

  // ---- Discovery ---------------------------------------------------------
  //
  // For anything non-trivial the professional answer to "what will this cost"
  // is a short paid discovery, not a number pulled off a form. These fields
  // let a proposal say exactly that.
  discoveryRequired Boolean @default(false) @map("discovery_required")
  discoveryPrice    BigInt? @map("discovery_price")
  discoveryDays     Int?    @map("discovery_days")

  timelineWeeksMin Int? @map("timeline_weeks_min")
  timelineWeeksMax Int? @map("timeline_weeks_max")

  /// Written to the client. Rendered on the tracking page.
  message       String?
  /// Never leaves the admin panel.
  internalNotes String? @map("internal_notes")

  validUntil DateTime? @map("valid_until")
  sentAt     DateTime? @map("sent_at")
  decidedAt  DateTime? @map("decided_at")

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("AuthoredProposals", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")

  @@unique([requestId, version])
  @@index([requestId])
  @@index([status])
  @@map("project_proposals")
}

/// A message from the public contact form.
///
/// Previously this form opened a `mailto:` link and stored nothing, so an
/// enquiry existed only if the visitor's machine had a mail client configured
/// and they went through with sending it. Anything else was lost silently,
/// which is the worst way to lose a customer.
/// A colleague on the public "تیم ما" page.
///
/// Ordered by an explicit integer rather than by name or join date, because
/// the order on that page is an editorial decision — who leads the list says
/// something — and it is the super admin's to make.
model TeamMember {
  id String @id @default(cuid())

  name  String
  /// Job title, shown under the name.
  title String
  /// A short paragraph. Optional: a member with nothing written yet should
  /// appear with their name and photograph rather than not at all.
  bio   String?

  /// Which section of the page this member appears under. Optional: a member
  /// with no section is listed after the sections, and a company with no
  /// sections at all gets one clean list.
  ///
  /// SetNull rather than Cascade: deleting a section is a decision about the
  /// page's structure, and it must never delete the people who were in it.
  sectionId String?      @map("section_id")
  section   TeamSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  /// The portrait. Stored through the attachment service like every other
  /// upload, so it is type-sniffed, malware-scanned and given a random name
  /// rather than the one the browser sent.
  photoStoredName   String? @map("photo_stored_name")
  photoOriginalName String? @map("photo_original_name")
  photoMimeType     String? @map("photo_mime_type")

  /// Optional ways to reach them. A public page, so these are the professional
  /// ones only — no personal phone number has a place here.
  email    String?
  linkedin String?
  github   String?
  website  String?

  /// Position in the list. Not unique: reordering swaps values and a unique
  /// constraint would make the intermediate state illegal, forcing every move
  /// through a temporary sentinel for no benefit.
  displayOrder Int @default(0) @map("display_order")

  /// Off means written but not yet shown. Somebody joining next month can be
  /// prepared in advance without appearing early.
  published Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([published, displayOrder])
  @@index([sectionId])
  @@map("team_members")
}

/// A heading on the "تیم ما" page — leadership, engineering, design.
///
/// A table rather than the free-text label members used to carry: a label is
/// retyped per member, so "Engineering" and "engineering " became two
/// departments, renaming one meant editing every member in it, and there was
/// no way to put sections in an order other than whoever happened to be first.
model TeamSection {
  id String @id @default(cuid())

  name        String
  /// A line under the heading. Optional.
  description String?

  displayOrder Int @default(0) @map("display_order")

  members TeamMember[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([displayOrder])
  @@map("team_sections")
}

// ---------------------------------------------------------------------------
// Showcase: who we work for, who we work with, and what we have built.
// ---------------------------------------------------------------------------

enum OrganizationKind {
  /// Listed in "باشگاه مشتریان".
  CUSTOMER
  /// Listed on the partners page.
  PARTNER
}

enum PartnershipType {
  TECHNOLOGY
  STRATEGIC
  ACADEMIC
  RESELLER
  COMMUNITY
  OTHER
}

/// A customer or a partner, as the company chooses to present them.
///
/// One table for both because they are the same record — a name, a logo, a
/// link, a sentence — and an organisation that starts as a customer and
/// becomes a partner is a change of kind, not a copy between tables.
model ShowcaseOrganization {
  id String @id @default(cuid())

  kind OrganizationKind

  name        String
  description String?
  industry    String?
  website     String?

  /// Stored through the attachment service like every other upload:
  /// type-sniffed, malware-scanned, and saved under a generated name.
  logoStoredName   String? @map("logo_stored_name")
  logoOriginalName String? @map("logo_original_name")
  logoMimeType     String? @map("logo_mime_type")

  /// "Best customers": shown first and larger. Partners use it the same way.
  featured  Boolean @default(false)
  /// False for a former customer or a partnership that has ended — still worth
  /// listing, but not presented as current.
  active    Boolean @default(true)
  /// The year the relationship began, Gregorian.
  sinceYear Int?    @map("since_year")

  /// Partners only; ignored for customers.
  partnershipType PartnershipType? @map("partnership_type")

  /// A quote, if they gave one. Only ever published with their agreement, which
  /// is why it is a field an admin fills in rather than anything collected.
  testimonialQuote  String? @map("testimonial_quote")
  testimonialAuthor String? @map("testimonial_author")
  testimonialRole   String? @map("testimonial_role")

  displayOrder Int     @default(0) @map("display_order")
  /// Off means prepared but not shown — an agreement not yet signed.
  published    Boolean @default(true)

  projects ShowcaseProject[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([kind, published, displayOrder])
  @@map("showcase_organizations")
}

enum ShowcaseProjectStatus {
  PLANNING
  IN_PROGRESS
  LAUNCHED
  MAINTAINED
  ARCHIVED
}

/// A project on the "our projects" page. Editorial, like the team page: what
/// appears and what it says is a decision, not a feed of every engagement.
model ShowcaseProject {
  id String @id @default(cuid())

  title       String
  /// One or two sentences for the card.
  summary     String
  /// The longer account, for the expanded view.
  description String?
  category    String?

  status       ShowcaseProjectStatus @default(IN_PROGRESS)
  technologies String[]              @default([])

  coverStoredName   String? @map("cover_stored_name")
  coverOriginalName String? @map("cover_original_name")
  coverMimeType     String? @map("cover_mime_type")

  projectUrl    String? @map("project_url")
  repositoryUrl String? @map("repository_url")

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  /// The customer it was built for, when that customer is listed and agreed to
  /// be named. SetNull: removing a customer from the club does not unbuild the
  /// project.
  clientId String?               @map("client_id")
  client   ShowcaseOrganization? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  featured     Boolean @default(false)
  displayOrder Int     @default(0) @map("display_order")
  published    Boolean @default(true)

  screenshots ShowcaseProjectShot[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([published, status, displayOrder])
  @@index([clientId])
  @@map("showcase_projects")
}

/// Where a contact ticket has got to.
///
/// There is no email in this deployment, so the status IS the communication:
/// a visitor learns their message was answered by looking it up, not by
/// receiving anything. That makes the transition to ANSWERED the moment the
/// reply becomes visible, which is why it is set by the reply itself rather
/// than toggled separately.
enum TicketStatus {
  /// Received, nobody has replied yet.
  OPEN
  /// A member of staff has written a reply the visitor can now read.
  ANSWERED
  /// Finished. Still readable by tracking code; no further replies expected.
  CLOSED
}

model ContactMessage {
  id String @id @default(cuid())

  /// What the visitor quotes to read the answer. There is no email out of
  /// this system, so this code is the ONLY way back to their own message —
  /// it is shown once on submission and cannot be recovered from here.
  trackingCode String @unique @map("tracking_code")

  status TicketStatus @default(OPEN)

  name      String
  email     String
  /// Deterministic hash for lookup and abuse checks without scanning
  /// plaintext, matching the convention on User.emailHash.
  emailHash String  @map("email_hash")
  subject   String?
  message   String

  /// Read/handled state. No enum: two booleans answer the only two questions
  /// anyone asks of an inbox, and adding a workflow later should be a
  /// deliberate act rather than something an enum invited.
  readAt        DateTime? @map("read_at")
  handledAt     DateTime? @map("handled_at")
  internalNotes String?   @map("internal_notes")

  replies ContactReply[]

  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")

  @@index([createdAt])
  @@index([emailHash])
  @@index([status, createdAt])
  @@map("contact_messages")
}

/// One staff answer on a contact ticket.
///
/// Staff-authored only. The visitor has no account and no session — they hold
/// a tracking code, which is enough to read but deliberately not enough to
/// write, since anyone who saw the code over somebody's shoulder would
/// otherwise be able to post as them.
model ContactReply {
  id String @id @default(cuid())

  messageId String         @map("message_id")
  message   ContactMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  body String

  /// Who wrote it. Nullable so the reply survives the account being removed —
  /// the visitor's record of what they were told should not disappear with a
  /// staff departure.
  authorId String? @map("author_id")
  author   User?   @relation("ContactReplyAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([messageId, createdAt])
  @@map("contact_replies")
}

// ===========================================================================
// Talent intake
//
// A person sends a CV; we read it and get in touch if something fits. There is
// no job board yet and no application-to-vacancy link — that is the next step,
// not this one — so a submission stands on its own.
// ===========================================================================

/// Which programme a CV was sent to.
///
/// Volunteers and interns go through the same intake as job applicants — the
/// same identity, upload checks, tracking codes and queue — because it is the
/// same problem. What differs is what we need to know, which is the handful of
/// nullable fields on the submission, and which pile it sits in.
enum TalentTrack {
  JOB
  VOLUNTEER
  INTERNSHIP
}

/// The kind of engineering work somebody wants to do with us.
enum TalentDiscipline {
  FRONTEND
  BACKEND
  FULLSTACK
  MOBILE
  DEVOPS
  DATA
  QA
  UI_UX
  OTHER
}

enum ResumeStatus {
  /// Received, nobody has read it yet.
  RECEIVED
  IN_REVIEW
  /// Worth keeping in front of us.
  SHORTLISTED
  /// Matched to something and in conversation.
  MATCHED
  /// Nothing right now, but worth revisiting.
  ON_HOLD
  DECLINED
  WITHDRAWN
}

model ResumeSubmission {
  id String @id @default(cuid())

  /// Quotable reference, from the same ambiguity-free alphabet as the other
  /// intakes — it gets read down a phone line too.
  trackingCode String @unique @map("tracking_code")

  /// The SAME identity record the project intake uses. One person who both
  /// commissions work and applies for a job is one identity, and the (email,
  /// phone) pairing rule is therefore enforced once, in one place, for both.
  identityId String         @map("identity_id")
  identity   ClientIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)

  // ---- Who ---------------------------------------------------------------
  fullName  String  @map("full_name")
  email     String
  phone     String
  city      String?
  province  String?
  /// Year of birth, Gregorian. Not a full date: nothing here needs a birthday,
  /// and asking for less of somebody's identity is the better default.
  birthYear Int?    @map("birth_year")

  /// Anything they want to say that the CV does not.
  coverNote String? @map("cover_note")

  // ---- Programme -----------------------------------------------------------
  //
  // Empty for an ordinary job CV. Filled in by the volunteer and internship
  // form, which asks what a placement actually turns on: what kind of work,
  // how many hours, from when, for how long.
  track          TalentTrack         @default(JOB)
  discipline     TalentDiscipline?
  hoursPerWeek   Int?                @map("hours_per_week")
  availableFrom  DateTime?           @map("available_from")
  durationMonths Int?                @map("duration_months")
  arrangement    JobWorkArrangement?
  /// Where they study or studied, and what — interns are usually students.
  university     String?
  fieldOfStudy   String?             @map("field_of_study")
  skills         String[]            @default([])
  githubUrl      String?             @map("github_url")
  portfolioUrl   String?             @map("portfolio_url")
  linkedinUrl    String?             @map("linkedin_url")

  // ---- The file ----------------------------------------------------------
  //
  // Exactly one, stored the same way project attachments are: outside any
  // served directory, under a generated name, with the type decided by the
  // file's own bytes.
  resumeOriginalName String @map("resume_original_name")
  resumeStoredName   String @unique @map("resume_stored_name")
  resumeMimeType     String @map("resume_mime_type")
  resumeSizeBytes    Int    @map("resume_size_bytes")
  resumeChecksum     String @map("resume_checksum")

  // ---- Handling ----------------------------------------------------------
  status        ResumeStatus @default(RECEIVED)
  internalNotes String?      @map("internal_notes")
  /// Free-text for now. A relation to a vacancy belongs to the job board that
  /// does not exist yet, and inventing the table early would guess its shape.
  matchedRole   String?      @map("matched_role")

  assignedToId String? @map("assigned_to_id")
  assignedTo   User?   @relation("AssignedResumes", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")

  @@index([status])
  @@index([createdAt])
  @@index([identityId])
  @@index([assignedToId])
  @@index([track, status])
  @@map("resume_submissions")
}

// ===========================================================================
// Marketplace — hiring and freelance work
//
// Two products over three shared subsystems.
//
//   Jobs       An employer posts a role; users apply.
//   Freelance  A client posts a piece of work; freelancers bid, and so can we.
//
//   Verification  Nobody posts or bids until an admin has seen who they are.
//   Moderation    Every post and every bid is reviewed before it reaches the
//                 other side. Approval is not a formality here: it is the
//                 product, because it is what makes a listing worth reading.
//   Award         Who won. Money is out of scope for now, so this records the
//                 outcome rather than settling it — the row a fee, an invoice
//                 or an escrow would later hang from.
//
// Deliberately NOT folded into ProjectRequest. That model is an account-less
// stranger asking OUR company to build something, answered by one proposal
// from us. This is a registered, verified user publishing to a market that
// many parties bid into. Same words, different actors, different lifecycle,
// different visibility — merging them would mean one model where half the
// columns are null in each direction.
// ===========================================================================

/// Whether an account acts for itself or for a registered business.
///
/// A company supplies registration details on top of the personal identity of
/// whoever operates the account; it never replaces it, because a company
/// cannot be held to anything and a person can.
enum AccountKind {
  INDIVIDUAL
  COMPANY
}

enum VerificationStatus {
  /// Never submitted. The state every account starts in.
  UNVERIFIED
  PENDING
  APPROVED
  /// Refused with a reason, and re-submittable — most rejections are a blurry
  /// photograph rather than a fraud attempt.
  REJECTED
}

/// Where something sits on its way to being visible to the other side.
///
/// Shared by posts and bids so that "what is waiting for review" is one
/// question with one answer, rather than three queues with three vocabularies.
enum ModerationStatus {
  DRAFT
  PENDING_REVIEW
  /// Sent back with a note. The author edits and resubmits; the history of
  /// what was asked for stays on the record.
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

/// What has happened to an approved listing since it went live.
enum ListingState {
  OPEN
  /// Someone was chosen. Still readable, no longer accepting anything.
  AWARDED
  /// Withdrawn by its author, or closed by staff.
  CLOSED
  EXPIRED
}

enum JobEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum JobWorkArrangement {
  ONSITE
  HYBRID
  REMOTE
}

/// What the poster decided about one application or bid, after staff approved
/// it and passed it on.
enum OfferOutcome {
  PENDING
  SHORTLISTED
  ACCEPTED
  DECLINED
  /// Pulled by the person who sent it.
  WITHDRAWN
}

enum VerificationDocumentKind {
  NATIONAL_ID_CARD
  PASSPORT
  /// A company's registration certificate — «آگهی تأسیس» or equivalent.
  COMPANY_REGISTRATION
  /// Proof the operator may act for the company.
  AUTHORITY_LETTER
  OTHER
}

// ===========================================================================
// Marketplace expansion — engagement, reputation, messaging, staff ops.
//
// Everything here hangs off the existing marketplace models. Awards gain a
// lifecycle (ACTIVE → COMPLETED/CANCELLED, with an optional dispute), and
// three new subsystems anchor on them or on the review-approved anchors:
// milestones + reviews on the award, messages on the application/bid.
// ===========================================================================

enum AwardStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DisputeStatus {
  NONE
  OPEN
  RESOLVED
}

enum MilestoneStatus {
  PENDING
  IN_REVIEW
  APPROVED
}

/// Who somebody is, checked by a person before they can trade on this.
///
/// One row per account. Identity is not per-listing: verifying the same person
/// twice tells you nothing new and doubles the review queue.
model UserVerification {
  id String @id @default(cuid())

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind   AccountKind        @default(INDIVIDUAL)
  status VerificationStatus @default(UNVERIFIED)

  // ---- The person, always -------------------------------------------------
  legalFirstName String    @map("legal_first_name")
  legalLastName  String    @map("legal_last_name")
  /// Iranian national id. Validated by utils/persian.ts before it is stored,
  /// so a check-digit failure never reaches a reviewer's queue.
  nationalId     String    @map("national_id")
  birthDate      DateTime? @map("birth_date")
  phone          String
  province       String?
  city           String?
  addressLine    String?   @map("address_line")

  // ---- The company, when there is one -------------------------------------
  companyName           String? @map("company_name")
  companyRegistrationNo String? @map("company_registration_no")
  /// «کد اقتصادی».
  companyEconomicCode   String? @map("company_economic_code")
  companyRole           String? @map("company_role")
  companyWebsite        String? @map("company_website")

  // ---- Review -------------------------------------------------------------
  submittedAt  DateTime? @map("submitted_at")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewedById String?   @map("reviewed_by_id")
  reviewedBy   User?     @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  /// Shown to the applicant. A rejection they cannot act on is a dead end.
  reviewNote   String?   @map("review_note")
  internalNote String?   @map("internal_note")

  documents VerificationDocument[]

  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")

  @@index([status])
  @@map("user_verifications")
}

/// An identity document. Stored through services/storage like every other
/// upload — never in a served directory, random name, scanned before writing.
model VerificationDocument {
  id String @id @default(cuid())

  verificationId String           @map("verification_id")
  verification   UserVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  kind VerificationDocumentKind

  originalName String @map("original_name")
  storedName   String @unique @map("stored_name")
  mimeType     String @map("mime_type")
  sizeBytes    Int    @map("size_bytes")
  checksum     String

  createdAt DateTime @default(now()) @map("createdAt")

  @@index([verificationId])
  @@map("verification_documents")
}

/// A role somebody is hiring for.
model JobPost {
  id String @id @default(cuid())

  /// Quotable public reference, same alphabet as the other tracking codes.
  code String @unique

  authorId String @map("author_id")
  author   User   @relation("JobAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  title       String
  description String
  /// Denormalised from the author's verification at publish time: an employer
  /// may verify as a company, and the listing should say which company even if
  /// the account is later changed.
  companyName String? @map("company_name")

  employmentType  JobEmploymentType
  workArrangement JobWorkArrangement
  province        String?
  city            String?

  salaryMin         BigInt? @map("salary_min")
  salaryMax         BigInt? @map("salary_max")
  currency          String  @default("IRT")
  salaryUndisclosed Boolean @default(false) @map("salary_undisclosed")

  skills String[] @default([])

  // ---- Moderation ---------------------------------------------------------
  moderationStatus ModerationStatus @default(DRAFT) @map("moderation_status")
  submittedAt      DateTime?        @map("submitted_at")
  reviewedAt       DateTime?        @map("reviewed_at")
  reviewedById     String?          @map("reviewed_by_id")
  reviewedBy       User?            @relation("JobReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  /// Shown to the author when changes are requested or it is rejected.
  reviewNote       String?          @map("review_note")
  internalNote     String?          @map("internal_note")

  // ---- Life after approval ------------------------------------------------
  state       ListingState @default(OPEN)
  publishedAt DateTime?    @map("published_at")
  closesAt    DateTime?    @map("closes_at")

  /// Free-text taxonomy tag, the same convention FreelanceProject.category
  /// already uses. Deliberately not a foreign key: the vocabulary should grow
  /// with what people post, not require a migration per new tag.
  category String?

  /// Staff-curated prominence (not paid — there is no monetization here).
  /// featuredAt lets "sort by recently featured" be honest.
  featured   Boolean   @default(false)
  featuredAt DateTime? @map("featured_at")

  /// Denormalized read counter, incremented on the public detail route.
  /// Under-counts slightly under the 60s board cache — accepted, and a read
  /// counter that never blocks a read is worth more than an exact one.
  viewCount Int @default(0) @map("view_count")

  applications JobApplication[]

  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")

  @@index([moderationStatus])
  @@index([state, publishedAt])
  @@index([authorId])
  @@index([featured, state])
  @@map("job_posts")
}

/// Somebody putting themselves forward for a role.
model JobApplication {
  id String @id @default(cuid())

  jobId String  @map("job_id")
  job   JobPost @relation(fields: [jobId], references: [id], onDelete: Cascade)

  applicantId String @map("applicant_id")
  applicant   User   @relation("JobApplicant", fields: [applicantId], references: [id], onDelete: Cascade)

  coverLetter    String? @map("cover_letter")
  expectedSalary BigInt? @map("expected_salary")

  /// One CV, inline — the same shape ResumeSubmission uses, for the same
  /// reason: exactly one file, so a join table would be ceremony.
  cvOriginalName String? @map("cv_original_name")
  cvStoredName   String? @unique @map("cv_stored_name")
  cvMimeType     String? @map("cv_mime_type")
  cvSizeBytes    Int?    @map("cv_size_bytes")
  cvChecksum     String? @map("cv_checksum")

  moderationStatus ModerationStatus @default(PENDING_REVIEW) @map("moderation_status")
  reviewedAt       DateTime?        @map("reviewed_at")
  reviewedById     String?          @map("reviewed_by_id")
  reviewedBy       User?            @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote       String?          @map("review_note")
  internalNote     String?          @map("internal_note")

  /// What the employer decided, once staff passed it on.
  outcome OfferOutcome @default(PENDING)

  /// Contact opens only after staff approved the application — the thread
  /// anchors here. See the note on MarketplaceMessage.
  messages MarketplaceMessage[]

  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")

  /// One application per person per role. A second one is an edit, not a new
  /// application, and letting both exist means the employer reads two.
  @@unique([jobId, applicantId])
  @@index([jobId, moderationStatus])
  @@index([applicantId])
  @@map("job_applications")
}

/// A piece of work put out to bid.
model FreelanceProject {
  id String @id @default(cuid())

  code String @unique

  authorId String @map("author_id")
  author   User   @relation("ProjectAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  title       String
  description String
  companyName String? @map("company_name")

  category String?
  skills   String[] @default([])

  budgetMin     BigInt? @map("budget_min")
  budgetMax     BigInt? @map("budget_max")
  currency      String  @default("IRT")
  budgetUnknown Boolean @default(false) @map("budget_unknown")

  deliverBy DateTime? @map("deliver_by")

  /// Whether the company may put its own offer in alongside the freelancers.
  /// The author's choice, asked at posting time, because somebody looking for
  /// an individual should not be pitched an agency without having agreed to it.
  openToCompanyOffer Boolean @default(true) @map("open_to_company_offer")

  moderationStatus ModerationStatus @default(DRAFT) @map("moderation_status")
  submittedAt      DateTime?        @map("submitted_at")
  reviewedAt       DateTime?        @map("reviewed_at")
  reviewedById     String?          @map("reviewed_by_id")
  reviewedBy       User?            @relation("ProjectReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote       String?          @map("review_note")
  internalNote     String?          @map("internal_note")

  state       ListingState @default(OPEN)
  publishedAt DateTime?    @map("published_at")
  closesAt    DateTime?    @map("closes_at")

  /// Same convention as JobPost: staff-curated, never paid.
  featured   Boolean   @default(false)
  featuredAt DateTime? @map("featured_at")

  /// See the note on JobPost.viewCount.
  viewCount Int @default(0) @map("view_count")

  attachments FreelanceAttachment[]
  bids        ProjectBid[]

  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")

  @@index([moderationStatus])
  @@index([state, publishedAt])
  @@index([authorId])
  @@index([featured, state])
  @@map("freelance_projects")
}

model FreelanceAttachment {
  id String @id @default(cuid())

  projectId String           @map("project_id")
  project   FreelanceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  originalName String @map("original_name")
  storedName   String @unique @map("stored_name")
  mimeType     String @map("mime_type")
  sizeBytes    Int    @map("size_bytes")
  checksum     String

  createdAt DateTime @default(now()) @map("createdAt")

  @@index([projectId])
  @@map("freelance_attachments")
}

/// An offer to do the work.
///
/// Sealed: a bidder sees only their own. That is deliberate — open bidding
/// turns a marketplace into a race to the bottom and pushes the serious
/// bidders out of going first.
///
/// It reaches staff BEFORE the poster. A reviewer judges whether the number is
/// fair for the work described and can send it back with a note, so somebody
/// who has badly under- or over-priced gets the chance to correct it rather
/// than simply losing or winning on a mistake.
model ProjectBid {
  id String @id @default(cuid())

  projectId String           @map("project_id")
  project   FreelanceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Null exactly when this is the company's own offer, which is submitted by
  /// staff rather than by an account bidding for itself.
  bidderId String? @map("bidder_id")
  bidder   User?   @relation("Bidder", fields: [bidderId], references: [id], onDelete: Cascade)

  /// Surfaced to the poster as the company's professional offer, so it is
  /// never mistaken for one freelancer among many.
  isCompanyOffer Boolean @default(false) @map("is_company_offer")

  amount       BigInt
  currency     String @default("IRT")
  /// Working days the bidder expects to need.
  deliveryDays Int?   @map("delivery_days")
  message      String

  /// One optional supporting file — a portfolio piece, a breakdown.
  attachmentOriginalName String? @map("attachment_original_name")
  attachmentStoredName   String? @unique @map("attachment_stored_name")
  attachmentMimeType     String? @map("attachment_mime_type")
  attachmentSizeBytes    Int?    @map("attachment_size_bytes")
  attachmentChecksum     String? @map("attachment_checksum")

  moderationStatus ModerationStatus @default(PENDING_REVIEW) @map("moderation_status")
  reviewedAt       DateTime?        @map("reviewed_at")
  reviewedById     String?          @map("reviewed_by_id")
  reviewedBy       User?            @relation("BidReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  /// The fairness note, shown to the BIDDER. This is the one that says "this
  /// looks low for the scope described" and invites a revision.
  reviewNote       String?          @map("review_note")
  internalNote     String?          @map("internal_note")
  /// What a reviewer thinks the work is actually worth. Advisory, never
  /// applied automatically — the price on the bid stays the bidder's own.
  suggestedAmount  BigInt?          @map("suggested_amount")

  outcome OfferOutcome @default(PENDING)

  /// Contact opens only after staff approved the bid. See the note on
  /// MarketplaceMessage.
  messages MarketplaceMessage[]

  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")

  /// One live bid per person per project, for the same reason as applications.
  /// The company's offer is exempt: bidderId is null there, and Postgres treats
  /// nulls as distinct in a unique index.
  @@unique([projectId, bidderId])
  @@index([projectId, moderationStatus])
  @@index([bidderId])
  @@map("project_bids")
}

/// Who won, and on what terms.
///
/// Money is out of scope for now, so this settles nothing. It exists because
/// the outcome is the thing worth recording even when no funds move, and
/// because a fee, an invoice or an escrow later hangs off exactly this row
/// rather than needing the history reconstructed.
model MarketplaceAward {
  id String @id @default(cuid())

  jobApplicationId String? @unique @map("job_application_id")
  projectBidId     String? @unique @map("project_bid_id")

  /// Copied at award time. The bid's amount may later be edited or the bid
  /// deleted; what was agreed should not move.
  agreedAmount BigInt? @map("agreed_amount")
  currency     String  @default("IRT")

  awardedById String? @map("awarded_by_id")
  awardedBy   User?   @relation("AwardedBy", fields: [awardedById], references: [id], onDelete: SetNull)

  note String?

  // ---- Engagement lifecycle ------------------------------------------------
  //
  // Money is out of scope, so the award is a commitment record, not a
  // settlement. The lifecycle is: ACTIVE (work happening) → COMPLETED (all
  // milestones approved, or parties agreed there was nothing to plan) or
  // CANCELLED. Either party can raise a dispute, which freezes completion
  // until staff resolve it.

  status      AwardStatus @default(ACTIVE)
  completedAt DateTime?   @map("completed_at")

  milestones MarketplaceMilestone[]
  reviews    MarketplaceReview[]

  disputeStatus         DisputeStatus @default(NONE) @map("dispute_status")
  disputeReason         String?       @map("dispute_reason")
  disputeOpenedAt       DateTime?     @map("dispute_opened_at")
  disputeResolvedAt     DateTime?     @map("dispute_resolved_at")
  disputeResolutionNote String?       @map("dispute_resolution_note")

  createdAt DateTime @default(now()) @map("createdAt")

  @@map("marketplace_awards")
}

/// A thread is anchored to exactly one application or one bid, and opens only
/// after staff approved that anchor — contact flows post-approval, matching
/// the moderation philosophy that makes the board worth reading in the first
/// place. Exactly one of applicationId/bidId is non-null; that invariant is
/// enforced in the service layer and covered by tests (a DB check expression
/// would be fine too, but the service is the only writer).
model MarketplaceMessage {
  id String @id @default(cuid())

  applicationId String?         @map("application_id")
  application   JobApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  bidId         String?         @map("bid_id")
  bid           ProjectBid?     @relation(fields: [bidId], references: [id], onDelete: Cascade)

  senderId String @map("sender_id")
  sender   User   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  /// Validated 1..2000 chars in the service layer.
  body String

  /// Set when the OTHER party reads the thread — read receipts per message,
  /// which is all a two-party thread needs.
  readAt DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("createdAt")

  @@index([applicationId, createdAt])
  @@index([bidId, createdAt])
  @@index([senderId])
  @@map("marketplace_messages")
}

/// In-app notification. `type` is a string rather than an enum so a new kind
/// never needs a migration — the notification service owns the vocabulary and
/// the web client renders unknown types as a generic row.
model Notification {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  String
  /// Pre-rendered display text in Persian; the client treats these as opaque.
  title String
  body  String
  /// A client-side route (e.g. /dashboard/projects), never an external URL.
  link  String?

  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("createdAt")

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// Ratings are two-sided and only exist after an award: one review per
/// direction per award, enforced by the unique key. The aggregate shown on
/// profiles is computed on read, not denormalized — a wrong cached average is
/// worse than a computed one at this volume.
model MarketplaceReview {
  id String @id @default(cuid())

  awardId String           @map("award_id")
  award   MarketplaceAward @relation(fields: [awardId], references: [id], onDelete: Cascade)

  raterId String @map("rater_id")
  rater   User   @relation("Rater", fields: [raterId], references: [id], onDelete: Cascade)
  rateeId String @map("ratee_id")
  ratee   User   @relation("Reviewee", fields: [rateeId], references: [id], onDelete: Cascade)

  /// 1..5, validated in the service layer.
  rating Int
  text   String?

  createdAt DateTime @default(now()) @map("createdAt")

  @@unique([awardId, raterId])
  @@index([rateeId])
  @@map("marketplace_reviews")
}

/// Work plan after an award. Money is out of scope, so a milestone is a
/// scope/time checkpoint only: the listing author writes the plan, the other
/// side delivers against it with a note (and one optional supporting file),
/// and the author approves. When every milestone is approved the award
/// completes itself.
model MarketplaceMilestone {
  id String @id @default(cuid())

  awardId String           @map("award_id")
  award   MarketplaceAward @relation(fields: [awardId], references: [id], onDelete: Cascade)

  /// 1, 2, 3 … within the award. Assigned by the service, never by the client.
  order Int

  title       String
  description String?
  dueDate     DateTime? @map("due_date")

  status MilestoneStatus @default(PENDING)

  deliveryNote         String?   @map("delivery_note")
  deliveredAt          DateTime? @map("delivered_at")
  /// One optional supporting file, stored exactly like a bid attachment:
  /// generated name, sniffed type, never under a served directory.
  deliveryOriginalName String?   @map("delivery_original_name")
  deliveryStoredName   String?   @unique @map("delivery_stored_name")
  deliveryMimeType     String?   @map("delivery_mime_type")
  deliverySizeBytes    Int?      @map("delivery_size_bytes")
  deliveryChecksum     String?   @map("delivery_checksum")

  approvedAt   DateTime? @map("approved_at")
  approvedById String?   @map("approved_by_id")

  createdAt DateTime @default(now()) @map("createdAt")

  @@unique([awardId, order])
  @@index([awardId, status])
  @@map("marketplace_milestones")
}

/// Every staff action that changes marketplace state outside the normal
/// review flow: feature/unfeature, deadline extensions, user pauses, dispute
/// resolutions. Review decisions already keep their history on the reviewed
/// rows; this log is the cross-module "who did what, when" and is readable
/// by SUPER_ADMIN only.
model MarketplaceAuditEntry {
  id String @id @default(cuid())

  actorId String @map("actor_id")

  /// e.g. job.featured, project.unfeatured, user.paused, award.dispute_resolved
  action     String
  /// job | project | user | award
  targetType String @map("target_type")
  targetId   String @map("target_id")

  meta Json?

  createdAt DateTime @default(now()) @map("createdAt")

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("marketplace_audit")
}

/// What state a copy is in. Two values because that is the whole decision a
/// buyer makes here — a five-point scale invites arguments about whether
/// "very good" and "good" differ, which nobody can settle from a photograph.
enum BookCondition {
  NEW
  USED
}

/// A book somebody is offering.
///
/// The market is a noticeboard, not a shop: there is no basket, no payment and
/// no stock count, because none of those exist yet and pretending otherwise
/// would be a promise the application cannot keep. A listing is a description,
/// one photograph and an asking price, and it takes the same moderated route
/// to publication as every other thing a member writes.
model BookListing {
  id String @id @default(cuid())

  /// Quotable public reference, as on every other listing.
  code String @unique

  sellerId String @map("seller_id")
  seller   User   @relation("BookSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  /// Frozen at creation rather than read from the seller's role.
  ///
  /// A member of staff who posts a book is the company speaking, and the
  /// listing says so. Deriving it from the current role would rewrite history
  /// the day somebody's admin rights are granted or taken away: adverts placed
  /// by a private seller would retroactively claim to be the company's.
  postedByCompany Boolean @default(false) @map("posted_by_company")

  title       String
  /// Who wrote the book, as opposed to who is selling it.
  bookAuthor  String @map("book_author")
  description String

  publisher   String?
  /// Digits only, 10 or 13, stored without separators. Optional: plenty of
  /// second-hand books predate the scheme or have lost the page that carried it.
  isbn        String?
  publishYear Int?    @map("publish_year")
  /// The language the book itself is written in, as a BCP-47 tag.
  language    String?
  pageCount   Int?    @map("page_count")
  category    String?

  condition  BookCondition
  /// Asking price. Nothing charges it — see the model comment.
  price      BigInt
  currency   String        @default("IRT")
  /// Whether the seller will consider offers. Display only.
  negotiable Boolean       @default(false)

  province String?
  city     String?

  /// Exactly one cover image, required at creation. See attachment.service for
  /// what is accepted and how it is checked.
  coverStoredName   String? @map("cover_stored_name")
  coverOriginalName String? @map("cover_original_name")
  coverMimeType     String? @map("cover_mime_type")

  moderationStatus ModerationStatus @default(DRAFT) @map("moderation_status")
  submittedAt      DateTime?        @map("submitted_at")
  reviewedAt       DateTime?        @map("reviewed_at")
  reviewedById     String?          @map("reviewed_by_id")
  reviewedBy       User?            @relation("BookReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote       String?          @map("review_note")
  internalNote     String?          @map("internal_note")

  state       ListingState @default(OPEN)
  publishedAt DateTime?    @map("published_at")

  /// Same convention as JobPost: staff-curated, never paid.
  featured   Boolean   @default(false)
  featuredAt DateTime? @map("featured_at")

  /// See the note on JobPost.viewCount.
  viewCount Int @default(0) @map("view_count")

  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")

  @@index([moderationStatus])
  @@index([state, publishedAt])
  @@index([sellerId])
  @@index([featured, state])
  @@map("book_listings")
}

/// A screenshot of a showcase project.
///
/// Separate from the cover because a gallery is a different job: the cover
/// identifies the project in a grid, these show what it actually looks like,
/// and there is no useful limit of one.
model ShowcaseProjectShot {
  id String @id @default(cuid())

  projectId String          @map("project_id")
  project   ShowcaseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  storedName   String  @map("stored_name")
  originalName String? @map("original_name")
  mimeType     String  @map("mime_type")
  /// Shown under the picture, and used as its alt text.
  caption      String?

  displayOrder Int @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId, displayOrder])
  @@map("showcase_project_shots")
}

/// What somebody wants to talk about.
///
/// Five, because the answer changes who should take the appointment — not so
/// many that choosing is itself a decision.
enum ConsultationTopic {
  /// Where to go next in a career already underway.
  CAREER
  /// A technical problem, architecture, a code review.
  TECHNICAL
  /// How to begin: which language, which path, what to study.
  STARTING_OUT
  /// Interviews, CVs, portfolios.
  HIRING
  OTHER
}

/// How they would like to meet.
enum ConsultationMode {
  ONLINE
  PHONE
  IN_PERSON
}

/// Which part of a day somebody is free.
///
/// Deliberately coarse. Asking for an exact time from a stranger whose week
/// we cannot see produces a time that has usually moved by the time anybody
/// rings; asking for "Tuesday afternoon" produces an answer that survives.
enum DayPart {
  MORNING
  AFTERNOON
  EVENING
}

/// Where a request has got to.
enum ConsultationStatus {
  NEW
  /// Somebody has picked it up and is arranging a time.
  CONTACTED
  SCHEDULED
  COMPLETED
  /// Tried, could not reach them. Distinct from cancelled: it may still happen.
  NO_ANSWER
  CANCELLED
}

/// Somebody who gives consultations, and appears in the club of experts.
///
/// Curated by staff rather than self-registered: the list is a statement
/// about who we vouch for, and an open sign-up makes it a statement about who
/// found the form. The shape leaves room for applications later — an expert
/// row does not care how it came to exist.
model Expert {
  id String @id @default(cuid())

  /// The public URL: /experts/<slug>. Stable across name changes.
  slug String @unique

  fullName String  @map("full_name")
  /// One line under the name: "Backend engineer, 12 years".
  headline String
  bio      String?

  /// What they can actually help with. Free text, because the field's own
  /// vocabulary moves faster than a migration.
  specialities String[] @default([])
  languages    String[] @default([])

  yearsExperience Int? @map("years_experience")

  photoStoredName   String? @map("photo_stored_name")
  photoOriginalName String? @map("photo_original_name")
  photoMimeType     String? @map("photo_mime_type")

  linkedinUrl String? @map("linkedin_url")
  githubUrl   String? @map("github_url")
  websiteUrl  String? @map("website_url")

  /// False for somebody listed for their standing who does not take
  /// appointments. The club and the consultation list are not the same list.
  acceptsConsultations Boolean @default(true) @map("accepts_consultations")

  featured     Boolean @default(false)
  displayOrder Int     @default(0) @map("display_order")
  published    Boolean @default(true)

  requests ConsultationRequest[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([published, displayOrder])
  @@map("experts")
}

/// Somebody asking for a consultation.
///
/// Not a booking: nothing is confirmed here. They say what they want to talk
/// about and when they could be free, and we ring them. That is the honest
/// shape for a small team — a public calendar of bookable slots promises an
/// availability nobody has committed to keeping, and a slot taken at 2am by a
/// stranger is a promise made by the software rather than by a person.
model ConsultationRequest {
  id String @id @default(cuid())

  /// How they check where it has got to. There is no mailbox in this
  /// deployment, so the code is the only thread back to the request.
  trackingCode String @unique @map("tracking_code")

  fullName        String  @map("full_name")
  phoneNumber     String  @map("phone_number")
  /// Deterministic hash for lookup without reading every row, as elsewhere.
  phoneNumberHash String? @map("phone_number_hash")
  email           String?

  topic      ConsultationTopic
  /// What they want out of the session, in their words.
  goal       String?
  /// Where they are now: student, switching field, three years in.
  background String?

  preferredMode ConsultationMode @default(ONLINE)

  /// Optional: somebody from the club they would like to speak to.
  /// SetNull, because removing an expert from the club must not delete the
  /// requests that named them.
  expertId String? @map("expert_id")
  expert   Expert? @relation(fields: [expertId], references: [id], onDelete: SetNull)

  availability ConsultationAvailability[]

  status    ConsultationStatus @default(NEW)
  /// Ours, never shown to the person who asked.
  staffNote String?            @map("staff_note")

  /// Who picked it up. SetNull so a staff account can be closed without
  /// erasing who handled what.
  assignedToId String? @map("assigned_to_id")
  assignedTo   User?   @relation("ConsultationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  contactedAt DateTime? @map("contacted_at")
  /// When the conversation was actually fixed for, once it is.
  scheduledAt DateTime? @map("scheduled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([expertId])
  @@map("consultation_requests")
}

/// One window somebody said they are free.
///
/// A row per option rather than a text field, so the queue can be sorted and
/// filtered by when people can actually talk — "who can do Thursday morning"
/// is the question staff ask, and free text cannot answer it.
model ConsultationAvailability {
  id String @id @default(cuid())

  requestId String              @map("request_id")
  request   ConsultationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  /// The day itself, with no time of day; the part says which half.
  day  DateTime @db.Date
  part DayPart

  @@unique([requestId, day, part])
  @@index([day, part])
  @@map("consultation_availability")
}

// ---------------------------------------------------------------------------
// TradeMaster
//
// The company's own product, arriving here as a module rather than a separate
// application: shops, a product catalogue, and — in a later phase — orders.
//
// It came from a codebase using Sequelize, integer primary keys and its own
// auth. None of that is reproduced. A shop's owner is a `User` from this
// schema, a shop can only be opened by somebody `UserVerification` has
// cleared, listings go through the same `ModerationStatus` pipeline as jobs,
// freelance projects and books, and buyers and sellers talk through the
// messaging that already exists. What is genuinely new is the shop, the
// product and the stock — the rest was already here and is reused.
//
// Not reachable in production until FEATURE_TRADEMASTER says so; see
// src/config/features.ts.
// ---------------------------------------------------------------------------

/// A seller's storefront.
model Business {
  id String @id @default(cuid())

  /// Quotable public reference, as on every other listing.
  code String @unique

  /// The part of the URL a seller hands out. Immutable once published: a shop
  /// that renames itself and breaks every link anyone shared is worse off than
  /// one with a dated name.
  slug String @unique

  ownerId String @map("owner_id")
  owner   User   @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  name        String
  /// One or two sentences for the shop card.
  summary     String
  description String?

  /// Free text rather than a foreign key. A shop's trade is how it describes
  /// itself to buyers, not a taxonomy anyone maintains.
  industry String?

  province String?
  city     String?
  address  String?

  /// Where the shop is, for the map and for "near me".
  ///
  /// Nullable because a shop that only ships has no doorstep worth pinning,
  /// and forcing a coordinate would produce fictional ones. Two columns rather
  /// than PostGIS: the search this needs is "within N km", which an index on
  /// latitude and longitude answers well enough, and adding an extension to
  /// the production database is a bigger decision than a distance filter
  /// justifies.
  latitude  Float?
  longitude Float?

  phone   String?
  email   String?
  website String?

  logoStoredName   String? @map("logo_stored_name")
  logoOriginalName String? @map("logo_original_name")
  logoMimeType     String? @map("logo_mime_type")

  /// The same review pipeline every other listing goes through.
  moderationStatus ModerationStatus @default(DRAFT) @map("moderation_status")
  /// Shown to the seller when their shop is sent back or refused.
  reviewNote       String?          @map("review_note")
  /// Never shown to the seller.
  internalNote     String?          @map("internal_note")
  reviewedAt       DateTime?        @map("reviewed_at")
  reviewedById     String?          @map("reviewed_by_id")
  reviewedBy       User?            @relation("BusinessReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  /// What has happened since approval. A shop can be closed by its owner or by
  /// staff without being un-approved, exactly like a job post.
  state       ListingState @default(OPEN)
  publishedAt DateTime?    @map("published_at")

  /// Editorial promotion, set by staff. Never bought.
  featured Boolean @default(false)

  products Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([ownerId])
  @@index([moderationStatus])
  @@index([state, publishedAt])
  @@index([province, city])
  @@index([latitude, longitude])
  @@index([featured, createdAt])
  @@map("businesses")
}

/// The catalogue tree products hang from.
///
/// A real table rather than free text, because buyers browse by it and a
/// typo'd category is a product nobody finds. Self-referencing so a shallow
/// tree is possible without a second model.
model ProductCategory {
  id String @id @default(cuid())

  slug String @unique
  name String

  parentId String?           @map("parent_id")
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryTree")

  /// Where it sits among its siblings. Editorial, like the showcase ordering.
  position Int     @default(0)
  active   Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentId, position])
  @@map("product_categories")
}

/// Something a shop sells.
model Product {
  id String @id @default(cuid())

  code String @unique
  slug String

  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  categoryId String?          @map("category_id")
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  title       String
  summary     String
  description String?

  /// Minor units, as everywhere else in this schema. BigInt because rial
  /// figures overflow a 32-bit integer at surprisingly ordinary prices.
  price    BigInt
  currency String @default("IRT")

  /// Stock for a product with no variants. When variants exist they carry
  /// their own and this is ignored — see ProductVariant.
  stock Int @default(0)

  /// Whether the seller will consider offers. Display only; nothing here
  /// negotiates or charges.
  negotiable Boolean @default(false)

  moderationStatus ModerationStatus @default(DRAFT) @map("moderation_status")
  reviewNote       String?          @map("review_note")
  internalNote     String?          @map("internal_note")
  reviewedAt       DateTime?        @map("reviewed_at")
  reviewedById     String?          @map("reviewed_by_id")
  reviewedBy       User?            @relation("ProductReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  state       ListingState @default(OPEN)
  publishedAt DateTime?    @map("published_at")
  featured    Boolean      @default(false)

  /// Denormalised counter, as on the other listings. Cheap to read on a
  /// listing page and not worth a join.
  views Int @default(0)

  images   ProductImage[]
  variants ProductVariant[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Unique per shop, not globally: two different shops may both sell a
  /// "blue-ceramic-mug" and neither should have to invent a worse name.
  @@unique([businessId, slug])
  @@index([businessId, moderationStatus])
  @@index([moderationStatus])
  @@index([state, publishedAt])
  @@index([categoryId, moderationStatus])
  @@index([featured, createdAt])
  @@map("products")
}

/// A picture of a product. Up to a documented maximum, enforced in the service.
model ProductImage {
  id String @id @default(cuid())

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  storedName   String @map("stored_name")
  originalName String @map("original_name")
  mimeType     String @map("mime_type")

  /// Shown under the picture and used as its alt text, so a screen reader gets
  /// something better than a file name.
  caption String?

  position Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId, position])
  @@map("product_images")
}

/// A variation of a product that has its own price and stock.
///
/// Size, colour, that sort of thing. Deliberately one flat level rather than a
/// general option/value matrix: the shops this serves sell mugs and shoes, and
/// a two-dimensional variant system is a great deal of machinery to get wrong
/// for sellers who mostly have none at all.
model ProductVariant {
  id String @id @default(cuid())

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// What distinguishes it: "Large", "Blue", "42".
  label String

  /// The seller's own stock-keeping code, if they use one.
  sku String?

  /// Overrides the product price when set. Null means "same as the product",
  /// which is the common case and better than copying the number and letting
  /// the two drift apart.
  price BigInt?

  stock Int @default(0)

  position Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, label])
  @@index([productId, position])
  @@map("product_variants")
}
