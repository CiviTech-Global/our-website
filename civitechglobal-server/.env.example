# --- Database ---
# In production, consider appending connection pool tuning params, which
# Prisma reads directly from the connection string, e.g.:
#   ?connection_limit=10&pool_timeout=20
DATABASE_URL="postgresql://civitech:civitech@localhost:5432/civitechglobal"

# --- Redis (login lockout tracking, shared by API) ---
REDIS_URL="redis://localhost:6379"

# --- JWT ---
# Generate strong random secrets, e.g. `openssl rand -hex 32`
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN="123456:ABC-your-bot-token-from-botfather"
# Comma-separated Telegram numeric user IDs that receive new-lead notifications
TELEGRAM_ADMIN_USER_IDS="111111111,222222222"
# Required only when TELEGRAM_BOT_MODE=webhook
TELEGRAM_WEBHOOK_SECRET="replace-with-a-random-webhook-secret"
TELEGRAM_WEBHOOK_URL=""
# "polling" (default, for local dev) or "webhook" (for production behind a public URL)
TELEGRAM_BOT_MODE="polling"

# --- SMS (one-time codes on insurance requests) ---
# Anyone can fill in an insurance form, so the phone number is verified before
# the request is accepted — it is the number a specialist calls back on.
#
# "console" logs the code to stdout instead of sending it. That is the right
# choice in development and is REFUSED AT STARTUP in production, because
# silently printing codes to the log would look like a working system while
# every applicant is locked out.
#
# Production: "kavenegar" or "smsir". Both send through a pre-approved verify
# template — a plain bulk-SMS send gets filtered on Iranian networks.
SMS_PROVIDER="console"
SMS_API_KEY=""
# Kavenegar: the template name. SMS.ir: the numeric template id.
SMS_OTP_TEMPLATE=""
SMS_SENDER=""

# How long a code stays valid, how long before another can be requested for the
# same number, and how many wrong guesses burn it.
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
# How long a verified-phone token stays usable to submit the form behind it.
PHONE_TOKEN_TTL_SECONDS=900

# --- Ports ---
PORT=5000
BOT_PORT=4000

# --- CORS ---
CORS_ORIGIN="http://localhost:5173"

# --- Cookies ---
# Set to "true" in production (HTTPS). Keep "false" for local HTTP development.
COOKIE_SECURE="false"

# --- Environment ---
NODE_ENV="development"
LOG_LEVEL="info"

# --- Error tracking (optional) ---
# When unset/empty, Sentry is never initialized (no-op) in both the API and
# the bot process.
SENTRY_DSN=""

# --- Default admin account (created by `npm run prisma:seed`) ---
# Without these set, the seed script generates a random password that is
# printed once to the console and never persisted — set these so the login
# is known and reproducible in local/dev environments.
SEED_ADMIN_EMAIL="admin@civitechglobal.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026Admin"

# Where client-supplied project attachments are written. MUST be outside any
# directory a web server serves: files here are never executed and never linked
# to directly — the only way out is an authenticated download route. In
# production this is a mounted volume so uploads survive a container rebuild.
UPLOAD_DIR=./storage/project-attachments
