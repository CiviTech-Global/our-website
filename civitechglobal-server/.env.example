# --- Database ---
# In production, consider appending connection pool tuning params, which
# Prisma reads directly from the connection string, e.g.:
#   ?connection_limit=10&pool_timeout=20
DATABASE_URL="postgresql://civitech:civitech@localhost:5432/civitechglobal"

# --- Redis (login lockout tracking, shared by API) ---
REDIS_URL="redis://localhost:6379"

# --- JWT ---
# Generate strong random secrets, e.g. `openssl rand -hex 32`
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"

# --- Telegram bot (LEGACY - not deployed) ---
# The bot is deliberately not part of the deployment: it is not built by CI,
# not in the compose files and not started by Ansible. These remain only so
# legacy source=TELEGRAM rows and a future restore keep working — see the
# note in docker-compose.yml.
TELEGRAM_BOT_TOKEN="123456:ABC-your-bot-token-from-botfather"
# Comma-separated Telegram numeric user IDs that receive new-lead notifications
TELEGRAM_ADMIN_USER_IDS="111111111,222222222"
# Required only when TELEGRAM_BOT_MODE=webhook
TELEGRAM_WEBHOOK_SECRET="replace-with-a-random-webhook-secret"
TELEGRAM_WEBHOOK_URL=""
# "polling" (default, for local dev) or "webhook" (for production behind a public URL)
TELEGRAM_BOT_MODE="polling"

# --- SMS (one-time codes on insurance requests) ---
# Anyone can fill in an insurance form, so the phone number is verified before
# the request is accepted — it is the number a specialist calls back on.
#
# "console" logs the code to stdout instead of sending it. That is the right
# choice in development and is REFUSED AT STARTUP in production, because
# silently printing codes to the log would look like a working system while
# every applicant is locked out.
#
# Production: "kavenegar" or "smsir". Both send through a pre-approved verify
# template — a plain bulk-SMS send gets filtered on Iranian networks.
SMS_PROVIDER="console"
SMS_API_KEY=""
# Kavenegar: the template name. SMS.ir: the numeric template id.
SMS_OTP_TEMPLATE=""
SMS_SENDER=""

# How long a code stays valid, how long before another can be requested for the
# same number, and how many wrong guesses burn it.
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
# How long a verified-phone token stays usable to submit the form behind it.
PHONE_TOKEN_TTL_SECONDS=900

# --- Ports ---
PORT=5000
BOT_PORT=4000

# --- CORS ---
CORS_ORIGIN="http://localhost:5173"

# --- Cookies ---
# Set to "true" in production (HTTPS). Keep "false" for local HTTP development.
COOKIE_SECURE="false"

# --- Environment ---
NODE_ENV="development"
LOG_LEVEL="info"

# --- Error tracking (optional) ---
# When unset/empty, Sentry is never initialized (no-op) in both the API and
# the bot process.
SENTRY_DSN=""

# --- Telemetry (optional) ---
# Bearer token for GET /api/metrics (Prometheus format). Unset means the
# endpoint 404s rather than describing traffic shape to anyone who asks.
METRICS_TOKEN=""

# --- Malware scanning (optional) ---
# "none" accepts uploads unscanned (production refuses this unless
# MALWARE_SCANNER_ALLOW_NONE=true is set deliberately). "clamav" streams each
# upload to the clamd container from the `scanning` compose profile.
MALWARE_SCANNER="none"
MALWARE_SCANNER_ALLOW_NONE=""
CLAMAV_HOST="clamav"
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000

# --- Uploaded file storage ---
# "local" writes to UPLOAD_DIR below. "s3" talks to any S3-compatible
# endpoint (ArvanCloud, MinIO, Backblaze, AWS); production refuses "local"
# unless STORAGE_ALLOW_LOCAL_IN_PRODUCTION=true says the directory is a
# durable, backed-up volume.
STORAGE_DRIVER="local"
STORAGE_ALLOW_LOCAL_IN_PRODUCTION=""
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
# Most non-AWS providers want endpoint/bucket/key rather than a subdomain.
STORAGE_FORCE_PATH_STYLE="true"

# --- Email (password reset, address verification) ---
# "console" logs the message instead of sending it (the development default;
# production refuses it). "resend" or "mailgun" send through a real provider.
EMAIL_PROVIDER="console"
EMAIL_API_KEY=""
# The From line. Must be an address on a domain the provider has verified.
EMAIL_FROM="no-reply@civitechglobal.com"
# Mailgun only: the sending domain.
EMAIL_DOMAIN=""
# Where the links in those emails point. Never derived from the request's own
# Host header.
APP_URL="http://localhost:5173"
# A reset link is a live credential; it should not sit in an inbox for days.
PASSWORD_RESET_TTL_MINUTES=60
# Verification is not a credential, so it can afford to be patient.
EMAIL_VERIFICATION_TTL_HOURS=48

# --- Default admin account (created by `npm run prisma:seed`) ---
# Without these set, the seed script generates a random password that is
# printed once to the console and never persisted — set these so the login
# is known and reproducible in local/dev environments.
SEED_ADMIN_EMAIL="admin@civitechglobal.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026Admin"

# Where client-supplied project attachments are written. MUST be outside any
# directory a web server serves: files here are never executed and never linked
# to directly — the only way out is an authenticated download route. In
# production this is a mounted volume so uploads survive a container rebuild.
UPLOAD_DIR=./storage/project-attachments
