{{ ansible_managed | comment }}
# Rendered by Ansible from roles/app/templates/docker-compose.prod.yml.j2.
# Layered on top of the repository's docker-compose.yml:
#
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# Three jobs, and nothing else: deploy pinned images instead of building,
# supply the real environment, and cap resources so one container cannot take
# the host down with it. Everything structural — service names, health checks,
# the one-shot migrate job, dependency ordering — stays in the base file.

services:
  postgres:
    ports: !reset []          # compose network only; nothing published
    deploy:
      resources:
        limits:
          memory: 512M

  redis:
    ports: !reset []
    # Redis holds rate-limit counters and login-lockout keys, all of which are
    # disposable. Bounding it means a runaway key pattern cannot starve
    # Postgres of memory, and LRU eviction degrades the limiter rather than
    # killing it — the limiters already fail open.
    command: ["redis-server", "--maxmemory", "128mb", "--maxmemory-policy", "allkeys-lru"]
    deploy:
      resources:
        limits:
          memory: 192M

  migrate:
    build: !reset null
    image: {{ image_api }}
    environment:
      DATABASE_URL: "postgresql://{{ postgres_user }}:{{ vault_postgres_password }}@postgres:5432/{{ postgres_db }}"

  api:
    build: !reset null        # deploy the CI image; never build on the server
    image: {{ image_api }}
    # !override, not a plain list: compose APPENDS list values from an
    # override file, so without it the base mapping stays published too.
    ports: !override
      - "127.0.0.1:{{ api_port }}:5000"
    # The base file reads civitechglobal-server/.env, which does not exist on
    # the server. Everything the API needs is set explicitly below.
    env_file: !reset []
    environment:
      NODE_ENV: "{{ node_env }}"
      PORT: "5000"
      # Prisma reads pool settings straight off the connection string. Its
      # default is cores*2+1 PER PROCESS, which stops being safe the moment
      # there is more than one API container.
      DATABASE_URL: "postgresql://{{ postgres_user }}:{{ vault_postgres_password }}@postgres:5432/{{ postgres_db }}?connection_limit={{ db_connection_limit }}&pool_timeout={{ db_pool_timeout }}"
      REDIS_URL: "redis://redis:6379"
      JWT_SECRET: "{{ vault_jwt_secret }}"
      JWT_REFRESH_SECRET: "{{ vault_jwt_refresh_secret }}"
      # Single origin, with credentials. A mismatch here means the API rejects
      # its own front end, which presents as "login does nothing".
      CORS_ORIGIN: "{{ 'https' if enable_ssl | bool else 'http' }}://{{ domain_name }}"
      # config/env.ts forces this true whenever NODE_ENV=production regardless,
      # but stating it keeps the intent visible in one place.
      COOKIE_SECURE: "true"
      LOG_LEVEL: "{{ log_level }}"
      # Uploaded files. 'local' means the named `uploads` volume from the base
      # compose file, which the nightly backup now also captures. Point
      # STORAGE_DRIVER at s3 once object storage exists and the volume becomes
      # dead weight rather than a single point of failure.
      STORAGE_DRIVER: "{{ storage_driver }}"
      STORAGE_ALLOW_LOCAL_IN_PRODUCTION: "{{ 'true' if storage_driver == 'local' else 'false' }}"
      STORAGE_ENDPOINT: "{{ storage_endpoint }}"
      STORAGE_BUCKET: "{{ storage_bucket }}"
      STORAGE_REGION: "{{ storage_region }}"
      STORAGE_ACCESS_KEY: "{{ vault_storage_access_key | default('') }}"
      STORAGE_SECRET_KEY: "{{ vault_storage_secret_key | default('') }}"
      # Links in reset and verification emails are built against this, never
      # against the request's Host header.
      APP_URL: "{{ 'https' if enable_ssl | bool else 'http' }}://{{ domain_name }}"
      EMAIL_PROVIDER: "{{ email_provider }}"
      EMAIL_API_KEY: "{{ vault_email_api_key | default('') }}"
      EMAIL_FROM: "{{ email_from }}"
      EMAIL_DOMAIN: "{{ email_domain | default('') }}"
      SENTRY_DSN: "{{ vault_sentry_dsn }}"
      SEED_ADMIN_EMAIL: "{{ vault_seed_admin_email }}"
      SEED_ADMIN_PASSWORD: "{{ vault_seed_admin_password }}"
      # One-time codes for insurance requests. config/env.ts refuses to start
      # on SMS_PROVIDER=console in production; deploy.yml asserts it earlier so
      # the failure lands on the playbook, not on a crash-looping container.
      SMS_PROVIDER: "{{ sms_provider }}"
      SMS_API_KEY: "{{ vault_sms_api_key }}"
      SMS_OTP_TEMPLATE: "{{ vault_sms_otp_template }}"
      OTP_TTL_SECONDS: "{{ otp_ttl_seconds }}"
      OTP_RESEND_COOLDOWN_SECONDS: "{{ otp_resend_cooldown_seconds }}"
      OTP_MAX_ATTEMPTS: "{{ otp_max_attempts }}"
      PHONE_TOKEN_TTL_SECONDS: "{{ phone_token_ttl_seconds }}"
    deploy:
      resources:
        limits:
          memory: 512M

  # No bot service. The base compose file does not define one either; see the
  # note there. Nothing Telegram-based is deployed.

  web:
    build: !reset null
    image: {{ image_web }}
    ports: !override
      - "127.0.0.1:{{ web_port }}:80"
    deploy:
      resources:
        limits:
          memory: 128M

  backup:
    # DISABLED IN PRODUCTION, on purpose.
    #
    # The compose sidecar is a self-host-friendly baseline that runs its own
    # sleep loop inside the stack. On a server managed by these playbooks the
    # backup is a systemd-scheduled cron job on the HOST instead
    # (roles/backup, /usr/local/bin/civitech-backup.sh), because:
    #
    #   - deploy.yml has to take a dump BEFORE it migrates, and it needs one
    #     command to call that works whether or not the stack is currently up;
    #   - one schedule is easier to reason about than two, and running both
    #     would dump the same database twice a night into the same directory;
    #   - the host job survives `docker compose down`, which is exactly when
    #     you are most likely to want a recent dump.
    #
    # A profile keeps the service defined but never started, so the base file
    # stays correct for a plain `docker compose up` on a laptop. Start it
    # explicitly with `--profile sidecar-backup` if you ever want it.
    profiles: ["sidecar-backup"]
