{{ ansible_managed | comment }}
# Rendered by Ansible from roles/app/templates/compose.env.j2. Mode 0600.
#
# Consumed by docker compose's own ${VAR} interpolation in the repository's
# docker-compose.yml. Application secrets are NOT here — they go straight into
# the environment: blocks of docker-compose.prod.yml, so that nothing reads
# them from a file the base compose also loads.

POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ vault_postgres_password }}
POSTGRES_DB={{ postgres_db }}

# The compose backup sidecar is disabled in production (see the prod
# override); the host cron job in roles/backup is the real one. These are set
# so the base file interpolates cleanly either way.
BACKUP_REMOTE={{ backup_remote }}
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS={{ backup_retention_days }}
