# Compose-level overrides for docker-compose.yml (postgres/api/bot services).
# Copy to .env at the repo root to override the dev-friendly defaults baked
# into docker-compose.yml. Not required for local development — the
# containers work out of the box without this file.
#
# Note: civitechglobal-server and civitechglobal-web have their own
# .env.example files for application-level configuration; this file only
# covers values consumed directly by docker-compose.yml.

POSTGRES_USER=civitech
POSTGRES_PASSWORD=civitech
POSTGRES_DB=civitechglobal
